# Variables de entorno para sap-fiori-mcp-server
# Copia este archivo como .env o usa los valores en el bloque "env" de tu cliente MCP.

# ---- Logging ----
# Niveles: off | error | warn | info | debug
LOG_LEVEL=error
# Ruta del log (por defecto ~/.sap-fiori-mcp/server.log)
#SAP_FIORI_MCP_LOG_FILE=~/.sap-fiori-mcp/server.log

# ---- Workspace ----
# Carpeta raíz sobre la que operan las tools que reciben rutas relativas
SAP_FIORI_MCP_WORKSPACE_ROOT=.

# ---- Conexión a SAP (sistema "default") ----
# URL base del sistema SAP, p.ej. https://vhcalnplci:44300
#SAP_BASE_URL=https://tu-sistema.sap.local:44300
#SAP_CLIENT=100
#SAP_USER=DEVELOPER
#SAP_PASSWORD=tu-password
# Nombre del sistema (default: "default")
#SAP_SYSTEM_NAME=S4H-DEV

# ---- Varios sistemas: JSON inline o archivo ----
#SAP_SYSTEMS_JSON=[{"name":"S4H-DEV","url":"https://host:44300","client":"100","user":"USER","password":"PASS"}]
# Por defecto: ~/.sap-fiori-mcp/systems.json  ->  [{ "name": "...", "url": "...", "client": "...", "user": "...", "password": "..." }]
#SAP_SYSTEMS_FILE=~/.sap-fiori-mcp/systems.json

# ---- Destinations SAP BTP (locales) ----
# JSON inline con la lista de destinations (formato cockpit export o camelCase)
#SAP_DESTINATIONS_JSON=[{"Name":"S4H","URL":"https://s4.example.com:44300","Authentication":"BasicAuthentication","User":"DEV","Password":"PASS","sap-client":"100"}]
# Alternativa Cloud SDK: variable 'destinations' con el mismo JSON
# Un JSON por destination en una carpeta (<nombre>.json); por defecto ~/.sap-fiori-mcp/destinations
#SAP_DESTINATIONS_DIR=~/.sap-fiori-mcp/destinations
# O un único archivo con un array / { "destinations": [...] }
#SAP_DESTINATIONS_FILE=~/.sap-fiori-mcp/destinations.json

# ---- BTP Destination Service (nube) ----
# Credenciales del service key del destino 'destination' + xsuaa del subaccount
#BTP_CLIENT_ID=sb-xxxx
#BTP_CLIENT_SECRET=xxxx
#BTP_TOKEN_URL=https://subaccount.authentication.eu10.hana.ondemand.com
#BTP_DESTINATION_API_URL=https://destination-configuration.cfapps.eu10.hana.ondemand.com
# Alternativa: VCAP_SERVICES con bindings 'destination' + 'xsuaa' (detección automática)
# Token de usuario para destinations OAuth2UserTokenExchange / OAuth2JWTBearer
#BTP_USER_TOKEN=

# Los ficheros systems.json y de destinations admiten ${env:NOMBRE} en cualquier campo,
# así la contraseña vive en el entorno y no en el fichero:
#   [{ "name": "A4H", "url": "https://host:44301", "client": "100",
#      "user": "${env:SAP_A4H_USER}", "password": "${env:SAP_A4H_PASSWORD}" }]

# ---- UI5 ----
# openui5 (default) | sapui5
UI5_DISTRIBUTION=openui5
# CDN alternativo (por defecto https://sdk.openui5.org o https://ui5.sap.com)
#UI5_CDN_URL=https://sdk.openui5.org
# CDN de los type definitions usados por get_api_reference
#UI5_TYPES_CDN_URL=https://cdn.jsdelivr.net/npm/@openui5/ts-types-esm

# ---- Seguridad ----
# API key obligatoria en modo HTTP (header x-api-key o Authorization: Bearer)
#SAP_FIORI_MCP_API_KEY=cambia-esto

# Allowlist de hosts salientes. Vacío (default) = sin restricción.
# Cuando la defines, limita las URLs que llegan como argumento de una tool (serviceUrl);
# los hosts de tus sistemas SAP, destinations y CDNs configurados siempre están permitidos.
# Admite comodín de subdominio: *.example.com
#SAP_FIORI_MCP_ALLOWED_DOMAINS=localhost,127.0.0.1,*.hana.ondemand.com

# Modo HTTP: orígenes aceptados (protección DNS-rebinding). Por defecto solo loopback.
# "*" desactiva la comprobación.
#SAP_FIORI_MCP_ALLOWED_ORIGINS=https://mi-equipo.example

# Prefijo para TODOS los nombres de tools, útil si convives con otros servidores MCP de SAP
# (p.ej. sapfiori_search_docs en vez de search_docs).
#SAP_FIORI_MCP_TOOL_PREFIX=sapfiori

# Certificados SSL autofirmados: apunta a tu CA en lugar de desactivar la validación
#NODE_EXTRA_CA_CERTS=/ruta/a/tu/ca.crt
# ⚠️ Solo para desarrollo, NUNCA en producción:
#NODE_TLS_REJECT_UNAUTHORIZED=0

# ---- Timeouts ----
# Timeout de requests OData/CDN en ms
#SAP_FIORI_MCP_TIMEOUT_MS=30000
